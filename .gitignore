/android/app/debug
/android/app/profile
/android/app/release


# Release signing material — NEVER commit. `key.properties` holds the keystore
# passwords and the .jks holds the private key that authorises Play Store
# updates; leaking either lets someone else publish as you (and it can't be
# rotated once Play has it as your upload key without contacting Google).
# `key.properties.example` is a different filename, so it stays tracked.
key.properties
android/key.properties
*.jks
*.keystore
*.p12
*.pepk

# Local secrets / env
.env
.env.*
!.env.example

# test files
*test.py

# Debug log dumps pulled off a device/emulator (e.g.
# `adb exec-out run-as com.example.watbal cat files/watbal_debug.log > logs/x.log`).
# The on-device file is watbal_debug.log; *.log above already covers it.
/logs/